# Copy to backend/.env or export in your shell. NEVER commit real secrets.

NETPULSE_DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
NETPULSE_DB_USER=postgres.YOUR_PROJECT_REF
NETPULSE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

AWS_REGION=us-east-2
NETPULSE_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/netpulse-monitoring-jobs

# Optional — prefer AWS_PROFILE / IAM role when possible
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=netpulse

# Opt-in scheduler (default false)
NETPULSE_SCHEDULER_ENABLED=false
