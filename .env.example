# Copy to backend/.env or export in your shell. NEVER commit real secrets.

NETPULSE_DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
NETPULSE_DB_USER=postgres.YOUR_PROJECT_REF
NETPULSE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

AWS_REGION=us-east-2
NETPULSE_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/netpulse-monitoring-jobs

# Optional — prefer AWS_PROFILE / IAM role when possible
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=netpulse

# Continuous in-process scheduler (default false). Keep false on Render Free + GitHub Actions.
NETPULSE_SCHEDULER_ENABLED=false
# One-shot enqueue then exit (GitHub Actions). Pair with SPRING_MAIN_WEB_APPLICATION_TYPE=none
# NETPULSE_SCHEDULE_ONCE=false

# Security mode: UNAUTHENTICATED_LOCALHOST_ONLY | HEALTH_ONLY | AUTHENTICATED
# NETPULSE_SECURITY_MODE=UNAUTHENTICATED_LOCALHOST_ONLY
# For AUTHENTICATED (Render): NETPULSE_ADMIN_USERNAME, NETPULSE_ADMIN_PASSWORD_HASH,
# NETPULSE_CORS_ALLOWED_ORIGINS, NETPULSE_SESSION_COOKIE_SAME_SITE, NETPULSE_SESSION_COOKIE_SECURE
