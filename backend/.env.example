# Copy to a local .env or export in your shell.
# NEVER commit real passwords. NEVER paste secrets into source control.

# Prefer the Supabase pooler on IPv4-only networks (port 6543).
# Pooler username is usually: postgres.<PROJECT_REF>
NETPULSE_DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
NETPULSE_DB_USER=postgres.YOUR_PROJECT_REF
NETPULSE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

AWS_REGION=us-east-2
NETPULSE_SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/netpulse-monitoring-jobs

# Optional AWS credential env vars (prefer `aws configure` / IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=netpulse

# Continuous scheduler opt-in (default false). Keep false for Render Free + GitHub Actions.
# NETPULSE_SCHEDULER_ENABLED=false
# One-shot enqueue for Actions/CLI (use SPRING_MAIN_WEB_APPLICATION_TYPE=none)
# NETPULSE_SCHEDULE_ONCE=false

# Security mode: UNAUTHENTICATED_LOCALHOST_ONLY | HEALTH_ONLY | AUTHENTICATED
# NETPULSE_SECURITY_MODE=UNAUTHENTICATED_LOCALHOST_ONLY

# AUTHENTICATED multi-user — password must be a BCrypt hash, never plaintext
# NETPULSE_ADMIN_EMAIL=admin@example.com
# NETPULSE_ADMIN_PASSWORD_HASH=$2a$10$...
# NETPULSE_CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# NETPULSE_SESSION_COOKIE_SAME_SITE=None
# NETPULSE_SESSION_COOKIE_SECURE=true
# NETPULSE_MAX_ENABLED_MONITORS_GLOBAL=40

# Optional SMTP (enables forgot/reset password only)
# NETPULSE_PUBLIC_BASE_URL=https://your-frontend.onrender.com
# NETPULSE_SMTP_HOST=smtp.example.com
# NETPULSE_SMTP_PORT=587
# NETPULSE_SMTP_USERNAME=
# NETPULSE_SMTP_PASSWORD=
# NETPULSE_SMTP_FROM=noreply@example.com
# NETPULSE_SMTP_STARTTLS=true

# Optional overrides
# SERVER_PORT=8080
# SERVER_ADDRESS=127.0.0.1
# PORT is used automatically on Render (overrides SERVER_PORT when set)
